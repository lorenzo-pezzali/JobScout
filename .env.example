# Optional server-side fallback keys, only used when a request doesn't carry
# its own apiKey (e.g. calling the API directly with curl). The app itself
# always sends the key from the browser's Settings, regardless of these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
